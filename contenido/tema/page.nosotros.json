   "bloques": [
    {
     "id": "description_QpUCTe",
     "tipo": "description",
     "ajustes": {
      "description": "<h5>Encontramos soluciones efectivas en otros países, pero con costo muy elevado para el mercado mexicano.</h5><h5>Fue entonces que <strong>decidimos crear nuestra propia versión: más económica, más práctica, y pensada para las necesidades reales en México.</strong><br/><br/>Como buenos emprendedores  pusimos manos a la obra y después de meses de prueba y error, finalmente llegamos a un prototipo funcional.</h5>"
     }
    }
   ]
