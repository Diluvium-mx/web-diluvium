# Copiar a .env y llenar. Nunca subir .env al repositorio.
# Llave para firmar las sesiones del administrador (openssl rand -hex 32).
PAYLOAD_SECRET=
# Base de datos del administrador. En esta Mac: archivo local.
DATABASE_URL=file:./datos/admin.db
# Correos de la tienda (src/lib/correos/). Sin RESEND_API_KEY los correos no se mandan: quedan como «pendiente» en
# «Correos enviados» del administrador. La llave se crea en Resend con el dominio diluvium.com.mx verificado.
RESEND_API_KEY=
# Remitente, p. ej.: Diluvium <pedidos@diluvium.com.mx>
CORREO_REMITENTE=
# Buzón de la tienda para «Pedido nuevo» y «Mensaje nuevo» (por omisión contacto@diluvium.com.mx).
CORREO_TIENDA=
