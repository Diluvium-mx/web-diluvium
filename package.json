{
  "name": "web-diluvium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Página propia de diluvium.com.mx (réplica exacta del sitio de Shopify)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "contenido": "python3 -I herramientas/contenido-tema.py",
    "medios": "node herramientas/descargar-medios.mjs",
    "capturar:referencia": "node herramientas/capturar-sitio.mjs docs/sitio-actual/capturas/2026-10-31",
    "comparar": "node herramientas/comparar.mjs",
    "admin:esquema": "python3 -I herramientas/esquema-secciones.py",
    "admin:sembrar": "tsx --env-file=.env src/payload/scripts/sembrar.ts",
    "admin:exportar": "tsx --env-file=.env src/payload/scripts/exportar.ts",
    "admin:agregar-plantillas": "tsx --env-file=.env src/payload/scripts/agregar-plantillas.ts",
    "admin:generar": "tsx --env-file=.env --tsconfig tsconfig.json src/payload/scripts/generar.ts",
    "prebuild": "node herramientas/medidas-imagenes.mjs",
    "cf:construir": "opennextjs-cloudflare build",
    "cf:probar": "opennextjs-cloudflare preview",
    "cf:tipos": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "admin:migrar": "tsx --env-file=.env src/payload/scripts/migrar.ts",
    "cf:local": "wrangler dev --local --port 8788 --ip 127.0.0.1",
    "cf:desplegar-prueba": "SITIO_PRUEBA=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:entrar": "wrangler login",
    "cf:crear": "wrangler d1 create diluvium && wrangler r2 bucket create diluvium-medios",
    "cf:llave": "node -e \"process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))\" | wrangler secret put PAYLOAD_SECRET",
    "prueba:medir": "node herramientas/publicar-prueba.mjs",
    "prueba:publicar": "node herramientas/publicar-prueba.mjs --publicar"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@payloadcms/db-d1-sqlite": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/storage-r2": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "graphql": "16.14.2",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
