    },
    {
     "tag": "span",
     "caja": [
      395,
      1346,
      616,
      81
     ],
     "texto": "Cuando el agua no tiene una vía de escape, busca seguir su curso natural, lo que resulta en un incremento de su nivel y, como consecuencia, ",
     "font": "Instrument Sans",
     "size": "18px",
     "weight": "400",
     "lh": "29.7px",
     "color": "rgb(0, 66, 136)",
     "align": "start"
    },
