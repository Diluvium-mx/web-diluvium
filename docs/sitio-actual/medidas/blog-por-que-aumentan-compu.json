     "caja": [
      395,
      2214,
      642,
      111
     ],
     "texto": "Además de los desechos generados por actividades humanas, también se produce una sedimentación natural que es arrastrada hacia los cuerpos d",
     "font": "Instrument Sans",
     "size": "18px",
     "weight": "400",
     "lh": "29.7px",
     "color": "rgb(0, 66, 136)",
