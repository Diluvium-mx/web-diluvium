    {
     "tag": "span",
     "caja": [
      395,
      1615,
      645,
      81
     ],
     "texto": "Aunque solemos ver el pavimento, el concreto y las construcciones como parte del desarrollo urbano sin considerarlos como contaminantes, en ",
     "font": "Instrument Sans",
     "size": "18px",
     "weight": "400",
     "lh": "29.7px",
     "color": "rgb(0, 66, 136)",
     "align": "start"
    },
    {
     "tag": "span",
     "caja": [
